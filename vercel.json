{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm run build:backend",
  "devCommand": "npm run dev --workspace frontend -- --port $PORT",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "frontend/dist",
  "regions": ["hnd1"],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "^.*\\.vercel\\.app$" }],
      "destination": "https://cidash.hanvinzie.com/$1",
      "statusCode": 301
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{backend/dist/serverless.mjs,node_modules/.prisma/client/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
