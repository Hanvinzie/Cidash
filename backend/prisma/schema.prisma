// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  CAPTAIN
}

enum ActivityType {
  RUNNING 
  CYCLING
}

// RECORDING = draft yang di-update client tiap batch GPS; COMPLETED = sudah di-finish & diverifikasi.
enum ActivityStatus {
  RECORDING
  COMPLETED
}

enum QuestStatus {
  PENDING
  ACCEPTED
  COMPLETED
  FAILED
  SHIELDED
}

enum PointTxType {
  QUEST_WIN
  QUEST_PENALTY
  PURCHASE_SHIELD
  ACTIVITY_REWARD
}

enum CoinTxType {
  TOP_UP
  BOMB_MISSION_FEE
  PURCHASE_SHIELD
  REFUND
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  coinBalance      Int               @default(0) // Saldo koin virtual untuk kirim Bomb Mission & top up
  rankPoints       Int               @default(100) // Poin peringkat kompetisi (Season reset 3 bulan)
  shieldTickets    Int               @default(0) // Tiket perisai pembatal penalti
  createdAt        DateTime          @default(now())

  squadsCreated    Squad[]           @relation("SquadCreator")
  memberships      SquadMember[]
  activities       Activity[]
  questsCreated    Quest[]           @relation("CreatedQuests")
  questsReceived   Quest[]           @relation("ReceivedQuests")
  pointLedgers     PointLedger[]
  coinTransactions CoinTransaction[]

  @@index([rankPoints(sort: Desc)])
}

model Squad {
  id          String        @id @default(uuid())
  name        String
  inviteCode  String        @unique // Kode unik 8 karakter (invite-only)
  isPremium   Boolean       @default(false)
  createdById String?
  createdAt   DateTime      @default(now())

  createdBy   User?         @relation("SquadCreator", fields: [createdById], references: [id])
  members     SquadMember[]
  quests      Quest[]
}

model SquadMember {
  id        String   @id @default(uuid())
  squadId   String
  userId    String
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())

  squad     Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([userId, joinedAt(sort: Desc)])
  @@index([squadId, joinedAt(sort: Asc)])
}

model Activity {
  id              String         @id @default(uuid())
  userId          String
  type            ActivityType
  status          ActivityStatus @default(COMPLETED)
  distanceMeters  Float
  durationSeconds Int
  averagePace     Float
  // Rute disimpan sebagai SATU string Google Encoded Polyline (presisi 5). Tidak ada baris per titik.
  encodedPolyline String?        @db.Text
  // Ringkasan titik awal/akhir agar daftar & peta ringkas tidak perlu mendekode polyline.
  startLat        Float?
  startLng        Float?
  endLat          Float?
  endLng          Float?
  elevationGain   Float          @default(0)
  // Label lokasi hasil reverse geocoding yang dijalankan sekali saat Finish (di-cache di sini).
  locationLabel   String?
  // Deprecated: format lama sebelum encodedPolyline. Baris lama tetap terbaca (di-encode saat dibaca).
  routeGeoJson    Json?
  startedAt       DateTime
  endedAt         DateTime

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questMatches    Quest[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, endedAt(sort: Desc)])
  @@index([userId, status, startedAt(sort: Desc)])
}

model Quest {
  id             String       @id @default(uuid())
  squadId        String
  creatorId      String
  targetUserId   String
  activityType   ActivityType
  targetDistance Float
  targetMaxPace  Float?
  stakesPoints   Int
  rewardTitle    String?
  deadline       DateTime
  status         QuestStatus  @default(PENDING)
  activityId     String?

  squad          Squad        @relation(fields: [squadId], references: [id], onDelete: Cascade)
  creator        User         @relation("CreatedQuests", fields: [creatorId], references: [id])
  targetUser     User         @relation("ReceivedQuests", fields: [targetUserId], references: [id])
  activity       Activity?    @relation(fields: [activityId], references: [id])

  @@index([squadId, status, deadline])
  @@index([targetUserId, status, deadline])
  @@index([status, deadline])
}

model PointLedger {
  id        String      @id @default(uuid())
  userId    String
  amount    Int
  type      PointTxType
  reference String?
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model CoinTransaction {
  id        String      @id @default(uuid())
  userId    String
  amount    Int         // Positif untuk Top Up, Negatif untuk pengeluaran biaya misi
  type      CoinTxType
  reference String?     // ID transaksi Payment Gateway (Midtrans/Xendit) / kode aksi internal
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), reference])
  @@index([reference])
}
