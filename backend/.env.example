# Database Configuration (Supabase / PostgreSQL)
DATABASE_URL="postgresql://username:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&pool_timeout=15&connect_timeout=10"
DIRECT_URL="postgresql://username:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# JWT Authentication Config (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX_CRYPTOGRAPHIC_SECRET"
JWT_EXPIRES_IN="7d"

# (Opsional) JWT secret proyek Supabase (Settings > API > JWT Secret). Dipakai GET /realtime/token untuk menerbitkan token
# Realtime berumur pendek agar Postgres Changes Group Run hanya mengirim baris milik circle pengguna.
# Kosongkan bila belum memakai Supabase Realtime: status sesi tetap sampai lewat sinyal Broadcast + REST.
# Setelah mengisi, jalankan sekali: npm run db:realtime --workspace backend
SUPABASE_JWT_SECRET=""

# CORS & Security Config
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
CRON_SECRET="REPLACE_WITH_64_CHAR_HEX_CRON_SECRET"

# Server Port
PORT=3000
