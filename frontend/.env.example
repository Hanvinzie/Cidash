# Base URL REST API backend NestJS.
# Kosongkan (default "/api") agar menggunakan same-origin relative path
# (otomatis diteruskan ke Vite proxy saat dev, atau Vercel Serverless Functions saat deploy).
# Isi URL eksternal hanya jika backend di-host di domain terpisah (mis. ngrok).
VITE_API_URL=""

# Live circle tracking (Supabase Realtime BROADCAST, posisi hanya lewat WebSocket, tidak menyentuh PostgreSQL).
# Kosongkan untuk mematikan fitur live circle.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# (Opsional) Style peta vector MapLibre. Default: OpenFreeMap (gratis, tanpa API key).
# Contoh MapTiler: https://api.maptiler.com/maps/streets-v2/style.json?key=KEY_ANDA
VITE_MAP_STYLE_URL=""
VITE_MAP_STYLE_URL_DARK=""

# (Opsional) Snap-to-road: merapikan rute ke jalan lewat server OSRM-kompatibel milik Anda sendiri.
# MATI bila kosong. Satu request per aktivitas, hanya saat Finish. {profile} diganti "foot" (lari) atau "bike" (sepeda).
# Contoh: https://osrm.example.com/match/v1/{profile}
# Jangan arahkan ke server demo publik OSRM; itu hanya untuk percobaan ringan dan melarang pemakaian berat.
VITE_MAP_MATCHING_URL=""

# (Opsional) Repo GitHub untuk daftar kontributor di About. Default: N11ch/Cidash (upstream).
VITE_GITHUB_REPO=""
